{
  "Info": "启动流程：打开游戏，等待加载，并进入游戏主界面。",
  "Start": {
    "type": "task",
    "next": [
      "OpenApp"
    ]
  },
  "OpenApp": {
    "Info": "点击桌面上的游戏图标，开始启动应用。",
    "action": "click",
    "recognization": "TemplateMatch",
    "template": "resource/images/app.png",
    "afterDelay": 16,
    "next": [
      "RandomClickAfterLaunch"
    ]
  },
  "RandomClickAfterLaunch": {
    "Info": "应用启动后随机点击空白区域，跳过可能的启动遮罩。",
    "action": "click",
    "recognization": "DirectHint",
    "random": true,
    "x1": 320,
    "y1": 180,
    "x2": 960,
    "y2": 540,
    "afterDelay": 3,
    "next": [
      "ClickGameStart"
    ]
  },
  "ClickGameStart": {
    "Info": "识别“进入游戏”按钮并点击，进入主界面。",
    "action": "click",
    "recognization": "OCR",
    "target": "进入游戏",
    "ocrConfig": "config_chinese.txt",
    "roi": {
      "xRatio": 0,
      "yRatio": 0.5,
      "widthRatio": 1,
      "heightRatio": 0.5
    },
    "beforeDelay": 1,
    "afterDelay": 1,
    "next": []
  }
}
